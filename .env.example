# -----------------------------------------------------------------------------
# Variables lues par docker-compose.yml (à la racine du projet).
# Copiez ce fichier vers ".env" à la racine. Les secrets backend (JWT_SECRET,
# ADMIN_API_KEY, MONGODB_URI applicatif, etc.) restent dans backend/.env — voir
# backend/config/env.example — et ne sont PAS dupliqués ici.
# -----------------------------------------------------------------------------

# Origine autorisée par CORS côté backend, doit correspondre au port publié du
# service "frontend" dans docker-compose.yml (3000:80 par défaut).
CLIENT_URL=http://localhost:3000

# URL de l'API utilisée par le frontend. Attention : Vite l'inline dans le
# bundle AU MOMENT DU BUILD (docker compose build), pas au runtime — un
# changement ici nécessite un "docker compose build frontend".
VITE_API_URL=http://localhost:5000/api

# Identifiant client Google AdSense (ca-pub-XXXXXXXXXXXXXXXX). Laisser vide en
# développement.
VITE_ADSENSE_CLIENT_ID=

# --- Connexion Google (déléguée à Supabase Auth) ---
# Project Settings > API sur votre projet Supabase (supabase.com/dashboard).
# Idem que dans frontend/.env.example : Vite les inline au moment du build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
