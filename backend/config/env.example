# -----------------------------------------------------------------------------
# Maalam Expert Backend — Variables d'environnement
# -----------------------------------------------------------------------------
# Copiez ce fichier vers ".env" à la racine du projet backend et renseignez
# les valeurs réelles. Ne JAMAIS committer le fichier ".env" dans Git.
# -----------------------------------------------------------------------------

# --- Serveur ---
NODE_ENV=development
PORT=5000

# URL du frontend autorisée par CORS (peut être une liste séparée par des virgules)
CLIENT_URL=http://localhost:3000

# --- Rate limiting ---
# Fenêtre glissante et nombre max de requêtes par IP sur /api (protection anti-abus/bots).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
# Fenêtre plus stricte sur /login et /register (protection anti-brute-force).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# --- Base de données ---
# Exemple local :        mongodb://127.0.0.1:27017/maalam-expert
# Exemple MongoDB Atlas : mongodb+srv://<user>:<password>@cluster.mongodb.net/maalam-expert
MONGODB_URI=mongodb://127.0.0.1:27017/maalam-expert

# --- Authentification JWT ---
# Générez une valeur forte, par ex. : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changez-moi-avec-une-valeur-aleatoire-et-longue
JWT_EXPIRES_IN=7d

# Nombre de tours de hachage bcrypt (12 est un bon compromis sécurité/performance en 2026)
BCRYPT_SALT_ROUNDS=12

# --- Clé d'administration (protège les routes de gestion du blog / des annonces) ---
# À transmettre uniquement à l'équipe interne via le header "x-admin-key".
ADMIN_API_KEY=changez-moi-avec-une-cle-admin-secrete

# --- Email (notifications transactionnelles, ex. Resend) ---
EMAIL_API_URL=https://api.resend.com
EMAIL_API_KEY=votre-cle-api-email
EMAIL_FROM_ADDRESS="Maalam Expert <no-reply@maalam-expert.ma>"

# --- SMS (notifications artisans, passerelle SMS marocaine) ---
SMS_API_URL=https://api.votre-passerelle-sms.ma
SMS_API_KEY=votre-cle-api-sms
SMS_SENDER_ID=Maalam Expert

# --- Diagnostic photo par IA (Google Gemini, niveau gratuit) ---
# Clé API gratuite (aucune carte bancaire requise) : https://aistudio.google.com/apikey
GEMINI_API_KEY=votre-cle-api-gemini
GEMINI_MODEL=gemini-2.5-flash

# --- Connexion Google (déléguée à Supabase Auth) ---
# Project Settings > API sur votre projet Supabase (supabase.com/dashboard).
# SUPABASE_ANON_KEY est la clé publique "anon" (safe à exposer, aussi utilisée côté frontend).
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre-cle-anon-supabase
