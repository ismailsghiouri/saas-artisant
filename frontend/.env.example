# URL de base de l'API Maalam Expert (backend Express)
VITE_API_URL=http://localhost:5000/api

# Identifiant client Google AdSense (ca-pub-XXXXXXXXXXXXXXXX).
# Laisser vide en développement : un emplacement de remplacement neutre
# s'affiche automatiquement à la place des publicités réelles.
VITE_ADSENSE_CLIENT_ID=

# --- Connexion Google (déléguée à Supabase Auth) ---
# Project Settings > API sur votre projet Supabase (supabase.com/dashboard).
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-supabase
